use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "create_gashboard_v010_schema", steps: ["CREATE TABLE IF NOT EXISTS vps_nodes (id TEXT PRIMARY KEY, label TEXT NOT NULL, host TEXT NOT NULL, ssh_port TEXT NOT NULL, ssh_user TEXT NOT NULL, host_key_fingerprint TEXT NOT NULL, encrypted_credential TEXT NOT NULL, environment TEXT NOT NULL, edge_proxy TEXT NOT NULL, domain TEXT NOT NULL, cpu_pct TEXT NOT NULL, ram_gb TEXT NOT NULL, disk_gb TEXT NOT NULL, grisp_workers TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS marketplace_installs (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, blueprint_id TEXT NOT NULL, app_name TEXT NOT NULL, domain TEXT NOT NULL, edge_proxy TEXT NOT NULL, read_only_enforced INTEGER NOT NULL, snapshot_id TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS ssh_tunnels (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, engine TEXT NOT NULL, local_host TEXT NOT NULL, local_port TEXT NOT NULL, remote_host TEXT NOT NULL, remote_port TEXT NOT NULL, ttl_minutes TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, expires_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS site_dna_deployments (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, dna_digest TEXT NOT NULL, lock_digest TEXT NOT NULL, snapshot_id TEXT NOT NULL, status TEXT NOT NULL, ready_status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_marketplace_node ON marketplace_installs(node_id, created_at)", "CREATE INDEX IF NOT EXISTS idx_tunnels_status ON ssh_tunnels(status, created_at)", "CREATE INDEX IF NOT EXISTS idx_dna_deploy_node ON site_dna_deployments(node_id, created_at)"]}]

show migration
