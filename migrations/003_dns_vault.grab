use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "create_gashboard_v010_schema", steps: ["CREATE TABLE IF NOT EXISTS vps_nodes (id TEXT PRIMARY KEY, label TEXT NOT NULL, host TEXT NOT NULL, ssh_port TEXT NOT NULL, ssh_user TEXT NOT NULL, host_key_fingerprint TEXT NOT NULL, encrypted_credential TEXT NOT NULL, environment TEXT NOT NULL, edge_proxy TEXT NOT NULL, domain TEXT NOT NULL, cpu_pct TEXT NOT NULL, ram_gb TEXT NOT NULL, disk_gb TEXT NOT NULL, grisp_workers TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS marketplace_installs (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, blueprint_id TEXT NOT NULL, app_name TEXT NOT NULL, domain TEXT NOT NULL, edge_proxy TEXT NOT NULL, read_only_enforced INTEGER NOT NULL, snapshot_id TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS ssh_tunnels (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, engine TEXT NOT NULL, local_host TEXT NOT NULL, local_port TEXT NOT NULL, remote_host TEXT NOT NULL, remote_port TEXT NOT NULL, ttl_minutes TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, expires_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS site_dna_deployments (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, dna_digest TEXT NOT NULL, lock_digest TEXT NOT NULL, snapshot_id TEXT NOT NULL, status TEXT NOT NULL, ready_status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_marketplace_node ON marketplace_installs(node_id, created_at)", "CREATE INDEX IF NOT EXISTS idx_tunnels_status ON ssh_tunnels(status, created_at)", "CREATE INDEX IF NOT EXISTS idx_dna_deploy_node ON site_dna_deployments(node_id, created_at)"]}, record {version: 2, name: "create_gashboard_v020_theme_and_db_manager", steps: ["CREATE TABLE IF NOT EXISTS ui_preferences (pref_key TEXT PRIMARY KEY, pref_value TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS db_mutation_snapshots (id TEXT PRIMARY KEY, target_id TEXT NOT NULL, target_kind TEXT NOT NULL, table_name TEXT NOT NULL, statement_preview TEXT NOT NULL, snapshot_path TEXT NOT NULL, backup_sha256 TEXT NOT NULL, approval_token_hash TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, restored_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS db_audit_logs (id TEXT PRIMARY KEY, target_id TEXT NOT NULL, operation_kind TEXT NOT NULL, sql_preview TEXT NOT NULL, row_count TEXT NOT NULL, snapshot_id TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_db_snapshots_target ON db_mutation_snapshots(target_id, created_at)", "CREATE INDEX IF NOT EXISTS idx_db_audit_target ON db_audit_logs(target_id, created_at)"]}, record {version: 3, name: "create_gashboard_v030_dns_vault", steps: ["CREATE TABLE IF NOT EXISTS dns_provider_credentials (id TEXT PRIMARY KEY, provider TEXT NOT NULL, api_user_enc TEXT NOT NULL, api_user_masked TEXT NOT NULL, api_key_enc TEXT NOT NULL, client_ip_enc TEXT NOT NULL, client_ip_masked TEXT NOT NULL, sandbox INTEGER NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS dns_host_snapshots (id TEXT PRIMARY KEY, domain TEXT NOT NULL, node_id TEXT NOT NULL, edge_proxy TEXT NOT NULL, subdomain TEXT NOT NULL, target_ip TEXT NOT NULL, prior_hosts_json TEXT NOT NULL, applied_hosts_json TEXT NOT NULL, preserved_email_count TEXT NOT NULL, backup_sha256 TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, rolled_back_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS https_edge_rollouts (id TEXT PRIMARY KEY, node_id TEXT NOT NULL, domain TEXT NOT NULL, edge_proxy TEXT NOT NULL, workspace TEXT NOT NULL, dns_snapshot_id TEXT NOT NULL, grabtac_deploy_id TEXT NOT NULL, pre_deploy_snapshot_id TEXT NOT NULL, ready_status TEXT NOT NULL, tls_verified INTEGER NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, rolled_back_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_dns_snapshots_domain ON dns_host_snapshots(domain, created_at)", "CREATE INDEX IF NOT EXISTS idx_https_rollouts_node ON https_edge_rollouts(node_id, created_at)"]}]

show migration
