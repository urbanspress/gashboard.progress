    if cached_tok is not nothing
      set apprv to cache_get_opt using c, ("apprv:" joined with cached_tok)
      if apprv is not nothing and (not apprv.used)
        set item to collections.put using item, "rollback_token", cached_tok
      end
    end
    set out to collections.append using out, item
  end
  give back out
end

make get_active_theme using s_get_pref
  try
    set row to data.one using s_get_pref, record {pref_key: "theme"}
    if row is not nothing
      if row.pref_value is "dark"
        give back "dark"
      end
    end
  catch err
    set ignored_err to err.message
  end
  give back "light"
end

make theme_wcag_metadata using mode_name
  if mode_name is "dark"
    give back record {mode: "dark", attribute: "data-grex-theme", standard: "WCAG-AA", min_normal_contrast: "4.5", tokens: record {bg: "#0b1120", surface: "#111827", text: "#f8fafc", muted: "#cbd5e1", accent: "#34d399", danger: "#f87171", border: "#475569", focus_ring: "#6ee7b7"}}
  end
  give back record {mode: "light", attribute: "data-grex-theme", standard: "WCAG-AA", min_normal_contrast: "4.5", tokens: record {bg: "#f8fafc", surface: "#ffffff", text: "#0f172a", muted: "#334155", accent: "#047857", danger: "#b91c1c", border: "#64748b", focus_ring: "#065f46"}}
end

make query_get_str using req, key, fallback
  if req is nothing or req.query is nothing
    give back fallback
  end
  if not (has_map_key using req.query, key)
    give back fallback
  end
  set vals to req.query at key
  if vals is nothing
    give back fallback
  end
  if is_list_value using vals
    try
      give back text.trim using (text.from using (vals at 0))
    catch err
      give back fallback
    end
  end
  give back text.trim using (text.from using vals)
end

make is_safe_sqlite_relpath using raw_p
  set p to text.trim using raw_p
  if p is ""
    give back no
  end
  set sl to text.replace using p, "\\", "/"
  if (text.starts_with using sl, "/") or (text.starts_with using sl, "//")
    give back no
  end
  if (text.contains using sl, ":") or (text.contains using sl, "..")
    give back no
  end
  set low to text.lower using sl
  set valid_ext to (text.ends_with using low, ".db") or (text.ends_with using low, ".sqlite") or (text.ends_with using low, ".sqlite3")
  if not valid_ext
    give back no
  end
  set segs to text.split using low, "/"
  for each seg in segs
    if seg is ".." or seg is ".git" or seg is ".ssh" or seg is ".gnupg" or seg is "id_rsa" or seg is "id_ed25519" or seg is "known_hosts" or seg is "authorized_keys" or seg is "secrets" or (text.starts_with using seg, ".env")
      give back no
    end
  end
  give back yes
end

make extract_target_map using payload
  if (has_map_key using payload, "target") and (is_record_value using (payload at "target"))
    give back payload at "target"
  end
  give back payload
end

make resolve_and_validate_db_target using target_map, s_get_tun
  set direct_host to text.trim using (map_get_str using target_map, "host", "")
  if direct_host is not ""
    give back record {ok: no, status: 422, code: "GASH-E422", error: "Direct public database host connections are blocked (ADR-005); use an active 127.0.0.1 SSH tunnel or confined local SQLite.", target: {}}
  end
  set eng to text.lower using (text.trim using (map_get_str using target_map, "engine", ""))
  set sq_path to text.trim using (map_get_str using target_map, "sqlite_path", "")
  set tun_id to text.trim using (map_get_str using target_map, "tunnel_id", "")
  set target_id to text.trim using (map_get_str using target_map, "target_id", "")

  if eng is ""
    if tun_id is not ""
      set tun_lookup to data.one using s_get_tun, record {id: tun_id}
      if tun_lookup is not nothing
        set eng to text.lower using tun_lookup.engine
      end
    otherwise
      set eng to "sqlite"
    end
  end
  if eng is "postgresql"
    set eng to "postgres"
  end
  if eng is "mysql"
    set eng to "mariadb"
  end
  if eng is "sqlite3"
    set eng to "sqlite"
  end

  if eng is "sqlite"
    if sq_path is "" and (target_id is "" or target_id is "sqlite:gashboard.db")
      set sq_path to "gashboard.db"
    end
    if not (is_safe_sqlite_relpath using sq_path)
      give back record {ok: no, status: 403, code: "GRAB-E401", error: "SQLite path failed workspace confinement check (GRAB-E401).", target: {}}
    end
    set out_id to target_id
    if out_id is ""
      set out_id to "sqlite:" joined with sq_path
    end
    give back record {ok: yes, status: 200, code: "", error: "", target: {"target_id": out_id, "engine": "sqlite", "sqlite_path": sq_path}}
  end

  if eng is "postgres" or eng is "mariadb"
    if tun_id is ""
      give back record {ok: no, status: 422, code: "GASH-E422", error: "tunnel_id is required for PostgreSQL/MariaDB inspection (zero public DB admin ports).", target: {}}
    end
    set tun_row to data.one using s_get_tun, record {id: tun_id}
    if tun_row is not nothing
      if tun_row.status is not "active"
        give back record {ok: no, status: 422, code: "GASH-E422", error: ("SSH tunnel " joined with tun_id joined with " is closed."), target: {}}
      end
      if tun_row.local_host is not "127.0.0.1"
        give back record {ok: no, status: 403, code: "GASH-E501", error: "SSH tunnel bind address must strictly remain 127.0.0.1.", target: {}}
      end
    end
    set out_id to target_id
    if out_id is ""
      set out_id to "tun:" joined with tun_id
    end
    set db_user to text.trim using (map_get_str using target_map, "db_user", "")
    set db_pass to map_get_str using target_map, "db_password", ""
    set db_name to text.trim using (map_get_str using target_map, "db_name", "")
    set schema_name to text.trim using (map_get_str using target_map, "schema_name", "")
    give back record {ok: yes, status: 200, code: "", error: "", target: {"target_id": out_id, "engine": eng, "tunnel_id": tun_id, "db_user": db_user, "db_password": db_pass, "db_name": db_name, "schema_name": schema_name}}
  end

  give back record {ok: no, status: 422, code: "GASH-E422", error: ("Unsupported database engine: " joined with eng), target: {}}
end

make enrich_db_snapshots_for_ui using c, raw_rows
  set out to []
  for each row in raw_rows
    set item to copy_to_map using row
    set cached_tok to cache_get_opt using c, ("db_rb:" joined with row.id)
    if cached_tok is not nothing
      set apprv to cache_get_opt using c, ("apprv:" joined with cached_tok)
      if apprv is not nothing and (not apprv.used)
        set item to collections.put using item, "restore_approval_token", cached_tok
      end
    end
    set out to collections.append using out, item
  end
  give back out
end

make list_db_targets_for_ui using s_list_tunnels
  set items to []
  set sq_item to record {target_id: "sqlite:gashboard.db", label: "Confined Workspace SQLite (gashboard.db)", engine: "sqlite", sqlite_path: "gashboard.db", transport: "local-confined", read_only_default: yes}
  set items to collections.append using items, sq_item
  set tuns to data.query using s_list_tunnels, record {}
  for each t in tuns
    set e to text.lower using t.engine
    if e is "postgres" or e is "postgresql" or e is "mariadb" or e is "mysql"
      set canon_e to e
      if canon_e is "postgresql"
        set canon_e to "postgres"
      end
      if canon_e is "mysql"
        set canon_e to "mariadb"
      end
      set lbl to canon_e joined with " via 127.0.0.1:" joined with t.local_port joined with " (" joined with t.id joined with ")"
      set ti to record {target_id: ("tun:" joined with t.id), label: lbl, engine: canon_e, tunnel_id: t.id, node_id: t.node_id, bind_host: t.local_host, local_port: t.local_port, transport: "127.0.0.1-ssh-tunnel", read_only_default: yes}
      set items to collections.append using items, ti
    end
  end
  give back items
end

make bridge_error_status using bridge_res, fallback_status
  if bridge_res.status is greater than 0
    give back bridge_res.status
  end
  give back fallback_status
end

make mask_short_secret using raw_s
  set s to text.trim using raw_s
  set n to text.length using s
  if n is 0
    give back ""
  end
  if n is less than 3
    give back "***"
  end
  set chars to text.split using s, ""
  if n is less than 5
    give back (chars at 0) joined with "***"
  end
  set prefix to (chars at 0) joined with (chars at 1)
  set suffix to (chars at (n minus 2)) joined with (chars at (n minus 1))
  give back prefix joined with "***" joined with suffix
end

make mask_ip_address using raw_ip
  set s to text.trim using raw_ip
  if s is ""
    give back ""
  end
  if text.contains using s, "."
    set octs to text.split using s, "."
    if (collections.length using octs) is 4
      give back (octs at 0) joined with "." joined with (octs at 1) joined with ".***." joined with (octs at 3)
    end
  end
  give back mask_short_secret using s
end

make is_valid_ipv4 using raw_ip
  set s to text.trim using raw_ip
  if (s is "") or (text.contains using s, " ")
    give back no
  end
  set parts to text.split using s, "."
  if (collections.length using parts) is not 4
    give back no
  end
  set digits to "0123456789"
  for each p in parts
    set plen to text.length using p
    if (plen is 0) or (plen is greater than 3)
      give back no
    end
    for each ch in (text.split using p, "")
      if not (text.contains using digits, ch)
        give back no
      end
    end
    try
      set num to text.to_integer using p
      if (num is less than 0) or (num is greater than 255)
        give back no
      end
    catch err
      give back no
    end
  end
  give back yes
end

make is_valid_ttl_wire using raw_val
  if not (is_strict_decimal_wire using raw_val)
    give back no
  end
  set s to text.trim using (text.from using raw_val)
  if text.contains using s, "."
    give back no
  end
  try
    set n to text.to_integer using s
    give back (not (n is less than 60)) and (not (n is greater than 86400))
  catch err
    give back no
  end
end

make map_get_bool using m, k, fallback
  if m is nothing
    give back fallback
  end
  if not (has_map_key using m, k)
    give back fallback
  end
  set v to m at k
  if v is nothing
    give back fallback
  end
  if v is yes or v is no
    give back v
  end
  set low to text.lower using (text.trim using (text.from using v))
  if low is "true" or low is "1" or low is "yes"
    give back yes
  end
  if low is "false" or low is "0" or low is "no"
    give back no
  end
  give back fallback
end

make load_decrypted_namecheap_creds using s_get_cred
  set row to data.one using s_get_cred, record {provider: "namecheap"}
  if row is nothing
    give back record {ok: no, status: 422, code: "GASH-E422", error: "Namecheap API credentials are not configured yet. Save them in the encrypted vault first.", creds: {}}
  end
  try
    set dec_user to decrypt_vault_secret using row.api_user_enc
    set dec_key to decrypt_vault_secret using row.api_key_enc
    set dec_ip to decrypt_vault_secret using row.client_ip_enc
    set is_sb to (row.sandbox is 1)
    give back record {ok: yes, status: 200, code: "", error: "", creds: {"api_user": dec_user, "api_key": dec_key, "client_ip": dec_ip, "sandbox": is_sb}}
  catch err
    give back record {ok: no, status: 500, code: "GASH-E500", error: "Failed to decrypt Namecheap vault credentials with configured GASHBOARD_MASTER_KEY.", creds: {}}
  end
end

