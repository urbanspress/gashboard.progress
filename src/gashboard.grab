route "GET" "/api/db/schema" using req
  set tmap to {"target_id": (query_get_str using req, "target_id", ""), "engine": (query_get_str using req, "engine", ""), "sqlite_path": (query_get_str using req, "sqlite_path", ""), "tunnel_id": (query_get_str using req, "tunnel_id", ""), "host": (query_get_str using req, "host", ""), "db_user": (query_get_str using req, "db_user", ""), "db_name": (query_get_str using req, "db_name", ""), "schema_name": (query_get_str using req, "schema_name", "")}
  set tv to resolve_and_validate_db_target using tmap, stmt_get_tunnel
  if not tv.ok
    give back server.json using tv.status, record {ok: no, code: tv.code, error: tv.error}
  end
  set br to bridge_post using "/v1/db/schema", tv.target
  if not br.configured
    give back server.json using 503, record {ok: no, code: "GASH-E503", error: "gashboard-bridge is not configured for DB inspection"}
  end
  if not br.ok
    set st_code to bridge_error_status using br, 502
    give back server.json using st_code, record {ok: no, code: br.code, error: br.error}
  end
  give back server.json using 200, br.data
end

