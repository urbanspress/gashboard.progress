route "POST" "/api/db/mutate/plan" using req
  if not (verify_csrf using gash_cache, req)
    give back server.json using 403, record {ok: no, code: "GASH-E403", error: "Invalid or missing X-CSRF-Token"}
  end
  try
    set payload to server.parse_json using req
    set tmap to extract_target_map using payload
    set tv to resolve_and_validate_db_target using tmap, stmt_get_tunnel
    if not tv.ok
      give back server.json using tv.status, record {ok: no, code: tv.code, error: tv.error}
    end
    set sql_text to text.trim using (map_get_str using payload, "sql", "")
    if sql_text is ""
      give back server.json using 422, record {ok: no, code: "GASH-E422", error: "sql mutation or DDL text is required"}
    end
    set br to bridge_post using "/v1/db/mutate/plan", {"target": tv.target, "sql": sql_text}
    if not br.configured
      give back server.json using 503, record {ok: no, code: "GASH-E503", error: "gashboard-bridge is not configured"}
    end
    if not br.ok
      set st_code to bridge_error_status using br, 422
      give back server.json using st_code, record {ok: no, code: br.code, error: br.error}
    end

    set snap_id to map_get_str using br.data, "snapshot_id", ""
    set target_id to map_get_str using tv.target, "target_id", "sqlite:gashboard.db"
    set eng to map_get_str using tv.target, "engine", "sqlite"
    set tbl_name to map_get_str using br.data, "table_name", ""
    set snap_path to map_get_str using br.data, "snapshot_path", ""
    set sha to map_get_str using br.data, "backup_sha256", ""
    set kind_txt to map_get_str using br.data, "kind", "dml"
    set verb_txt to map_get_str using br.data, "verb", "MUTATE"
    set summary_txt to map_get_str using br.data, "plain_summary", ""
    set pre_rows to map_get_str using br.data, "pre_row_count", "0"
    set stmt_cnt to map_get_str using br.data, "statement_count", "1"

    set plan_rec to record {snapshot_id: snap_id, target_id: target_id, target: tv.target, sql: sql_text, kind: kind_txt, table_name: tbl_name, backup_sha256: sha}
    set tok to mint_approval using gash_cache, "db_mutate", plan_rec
    set tok_hash to crypto.sha256_hex using tok
    set now_r to call dates.now_utc

    call data.execute using stmt_insert_db_snapshot, record {id: snap_id, target_id: target_id, target_kind: eng, table_name: tbl_name, statement_preview: summary_txt, snapshot_path: snap_path, backup_sha256: sha, approval_token_hash: tok_hash, status: "planned", created_at: now_r.iso, restored_at: ""}

    give back server.json using 200, record {ok: yes, snapshot_id: snap_id, target_id: target_id, engine: eng, kind: kind_txt, verb: verb_txt, table_name: tbl_name, statement_count: stmt_cnt, pre_row_count: pre_rows, plain_summary: summary_txt, snapshot_path: snap_path, backup_sha256: sha, approval_token: tok}
  catch err
    give back server.json using 400, record {ok: no, error: err.message}
  end
end

route "POST" "/api/db/mutate/execute" using req
  if not (verify_csrf using gash_cache, req)
    give back server.json using 403, record {ok: no, code: "GASH-E403", error: "Invalid or missing X-CSRF-Token"}
  end
  try
    set payload to server.parse_json using req
    set tok to map_get_str using payload, "approval_token", ""
    set chk to consume_approval using gash_cache, tok, "db_mutate"
    if not chk.ok
      give back server.json using chk.status, record {ok: no, code: chk.code, error: chk.error}
    end
    set plan to chk.payload
    set req_snap_id to text.trim using (map_get_str using payload, "snapshot_id", "")
    if (req_snap_id is not "") and (req_snap_id is not plan.snapshot_id)
      give back server.json using 403, record {ok: no, code: "GASH-E403", error: "approval_token snapshot_id mismatch"}
    end
    set req_target_id to text.trim using (map_get_str using payload, "target_id", "")
    if (req_target_id is not "") and (req_target_id is not plan.target_id)
      give back server.json using 403, record {ok: no, code: "GASH-E403", error: "approval_token target_id mismatch"}
    end
    set br to bridge_post using "/v1/db/mutate/execute", {"target": plan.target, "sql": plan.sql, "snapshot_id": plan.snapshot_id}
    if not br.configured
      give back server.json using 503, record {ok: no, code: "GASH-E503", error: "gashboard-bridge is not configured"}
    end
    set now_r to call dates.now_utc
    set audit_id to "dbaud_" joined with (crypto.random_hex using 16)
    if not br.ok
      call data.execute using stmt_insert_db_audit, record {id: audit_id, target_id: plan.target_id, operation_kind: plan.kind, sql_preview: plan.sql, row_count: "0", snapshot_id: plan.snapshot_id, status: "failed_rolled_back", created_at: now_r.iso}
      set st_code to bridge_error_status using br, 422
      give back server.json using st_code, record {ok: no, code: br.code, error: br.error}
    end

    set affected to map_get_str using br.data, "affected_rows", "0"
    call data.execute using stmt_mark_db_snapshot, record {status: "executed", restored_at: "", id: plan.snapshot_id}
    call data.execute using stmt_insert_db_audit, record {id: audit_id, target_id: plan.target_id, operation_kind: plan.kind, sql_preview: plan.sql, row_count: affected, snapshot_id: plan.snapshot_id, status: "executed", created_at: now_r.iso}

    set rb_tok to mint_approval using gash_cache, "db_restore", record {snapshot_id: plan.snapshot_id, target_id: plan.target_id, target: plan.target, backup_sha256: plan.backup_sha256}
    call cache.set using gash_cache, ("db_rb:" joined with plan.snapshot_id), rb_tok, 3600000

    set raw_snaps to data.query using stmt_list_db_snapshots, record {}
    set snaps_out to enrich_db_snapshots_for_ui using gash_cache, raw_snaps
    set audits_out to data.query using stmt_list_db_audits, record {}

    give back server.json using 200, record {ok: yes, execution: br.data, snapshot_id: plan.snapshot_id, restore_approval_token: rb_tok, snapshots: snaps_out, audits: audits_out}
  catch err
    give back server.json using 400, record {ok: no, error: err.message}
  end
end

route "POST" "/api/db/export" using req
  if not (verify_csrf using gash_cache, req)
    give back server.json using 403, record {ok: no, code: "GASH-E403", error: "Invalid or missing X-CSRF-Token"}
  end
  try
    set payload to server.parse_json using req
    set tmap to extract_target_map using payload
