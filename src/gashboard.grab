route "POST" "/api/db/rows" using req
  if not (verify_csrf using gash_cache, req)
    give back server.json using 403, record {ok: no, code: "GASH-E403", error: "Invalid or missing X-CSRF-Token"}
  end
  try
    set payload to server.parse_json using req
    set tmap to extract_target_map using payload
    set tv to resolve_and_validate_db_target using tmap, stmt_get_tunnel
    if not tv.ok
      give back server.json using tv.status, record {ok: no, code: tv.code, error: tv.error}
    end
    set wire_check to validate_wire_fields using payload, ["page", "limit"]
    if not wire_check.ok
      give back server.json using 422, record {ok: no, code: "GASH-E422", error: ("ADR-025c violation: field \"" joined with wire_check.field joined with "\" must be an exact base-10 wire string.")}
    end
    set table_name to text.trim using (map_get_str using payload, "table", "")
    set page_str to text.trim using (map_get_str using payload, "page", "1")
    set limit_str to text.trim using (map_get_str using payload, "limit", "25")
    if (text.contains using page_str, ".") or (text.contains using limit_str, ".")
      give back server.json using 422, record {ok: no, code: "GASH-E422", error: "page and limit must be integer wire strings"}
    end
    set p_int to text.to_integer using page_str
    set l_int to text.to_integer using limit_str
    if p_int is less than 1 or l_int is less than 1 or l_int is greater than 100
      give back server.json using 422, record {ok: no, code: "GASH-E422", error: "Pagination bounds require page >= 1 and 1 <= limit <= 100"}
    end
    set sort_col to text.trim using (map_get_str using payload, "sort_col", "")
    set sort_dir to text.trim using (map_get_str using payload, "sort_dir", "ASC")
    set filter_col to text.trim using (map_get_str using payload, "filter_col", "")
    set filter_op to text.trim using (map_get_str using payload, "filter_op", "contains")
    set filter_val to map_get_str using payload, "filter_val", ""
    set br to bridge_post using "/v1/db/rows", {"target": tv.target, "table": table_name, "page": page_str, "limit": limit_str, "sort_col": sort_col, "sort_dir": sort_dir, "filter_col": filter_col, "filter_op": filter_op, "filter_val": filter_val}
    if not br.configured
      give back server.json using 503, record {ok: no, code: "GASH-E503", error: "gashboard-bridge is not configured"}
    end
    if not br.ok
      set st_code to bridge_error_status using br, 422
      give back server.json using st_code, record {ok: no, code: br.code, error: br.error}
    end
    give back server.json using 200, br.data
  catch err
    give back server.json using 400, record {ok: no, error: err.message}
  end
end

route "POST" "/api/db/query" using req
  if not (verify_csrf using gash_cache, req)
