    if not tv.ok
      give back server.json using tv.status, record {ok: no, code: tv.code, error: tv.error}
    end
    set table_name to text.trim using (map_get_str using payload, "table", "")
    set filename to text.trim using (map_get_str using payload, "filename", "")
    set save_flag to no
    if (has_map_key using payload, "save_file") and ((payload at "save_file") is yes)
      set save_flag to yes
    end
    set br to bridge_post using "/v1/db/export", {"target": tv.target, "table": table_name, "save_file": save_flag, "filename": filename}
    if not br.configured
      give back server.json using 503, record {ok: no, code: "GASH-E503", error: "gashboard-bridge is not configured"}
    end
    if not br.ok
      set st_code to bridge_error_status using br, 422
      give back server.json using st_code, record {ok: no, code: br.code, error: br.error}
